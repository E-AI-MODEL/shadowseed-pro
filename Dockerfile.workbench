FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    GRADIO_ANALYTICS_ENABLED=False \
    PATH="/app/.venv/bin:${PATH}"

WORKDIR /app
COPY . /app
RUN python -m pip install --no-cache-dir "uv==0.8.14" && \
    uv sync --locked --extra workbench --no-dev

VOLUME ["/data"]
EXPOSE 7860

ENTRYPOINT ["shadowseed", "workbench", "--workspace", "/data", "--host", "0.0.0.0", "--allow-remote", "--no-browser"]
